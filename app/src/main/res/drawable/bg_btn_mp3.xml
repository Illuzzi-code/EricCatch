<?xml version="1.0" encoding="utf-8"?>
<!-- Botón MP3 — gradiente rose → magenta → amber con brillo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow exterior -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#50F43F5E"
                android:endColor="#30F97316"
                android:angle="135" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Gradiente principal -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/mp3_start"
                android:centerColor="@color/mp3_mid"
                android:endColor="@color/mp3_end"
                android:angle="135" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Specular highlight -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="27dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp" />
        </shape>
    </item>
</layer-list>
