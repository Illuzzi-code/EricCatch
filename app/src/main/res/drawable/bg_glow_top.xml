<?xml version="1.0" encoding="utf-8"?>
<!-- Halo púrpura difuso detrás del toolbar, simula un ambient glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="80%"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#3D8B5CF6"
                android:endColor="#00070711" />
        </shape>
    </item>
</layer-list>
